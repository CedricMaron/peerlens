{
  "id": "universal_claim_one_dataset",
  "description": "A universal claim rests on evidence from a single dataset.",
  "target": {
    "kind": "section_review",
    "section": "contribution"
  },
  "inputs": [
    {
      "label": "Draft contributions",
      "content": "\nWe evaluate our urban heat model only on one city (Lyon, summer 2023, 40 sensor\nstations). It reaches 2.1 C mean absolute error vs 2.9 C for the interpolation\nbaseline.\n\nContribution: We show that street-level humidity readings improve urban heat\nprediction. Our abstract states: \"Humidity readings improve urban heat prediction\nin cities.\" The conclusion states that the method is an effective general solution\nfor urban climate monitoring.\n"
    }
  ],
  "expect": {
    "min_severity": "major",
    "signals": [
      {
        "name": "identifies the single-dataset evidence base",
        "any": [
          "single dataset",
          "one dataset",
          "one city",
          "only lyon",
          "single city",
          "sole dataset",
          "a single benchmark",
          "one benchmark",
          "one site",
          "single site"
        ]
      },
      {
        "name": "names the overgeneralisation",
        "any": [
          "overgeneral",
          "over-general",
          "broader than",
          "exceeds the evidence",
          "not supported by the scope",
          "generalis",
          "generaliz",
          "universal claim",
          "unconditional"
        ]
      },
      {
        "name": "recommends narrowing the claim or widening the evidence",
        "any": [
          "narrow",
          "restrict",
          "qualify",
          "scope the claim",
          "additional dataset",
          "more cities",
          "another city",
          "condition the claim",
          "weaker form",
          "hedge"
        ]
      }
    ],
    "forbidden": [
      {
        "name": "does not praise the contribution",
        "any": [
          "impressive",
          "compelling contribution",
          "strong contribution",
          "excellent work"
        ]
      }
    ]
  }
}
