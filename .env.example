# PeerLens configuration — ALL OPTIONAL.
#
# Normal local use needs none of this: configure your AI provider in the app at
# Settings -> AI Provider. These variables exist for server deployments and CI.
#
# Copy to .env only if you need them:  cp .env.example .env
# Never commit a real .env — it is git-ignored for that reason.

# --- Storage ---------------------------------------------------------------
# Where the SQLite database and uploaded research live.
# Defaults to ./data locally, and /app/data inside the Docker image.
# PEERLENS_DATA_DIR=/app/data

# --- AI provider (optional; the Settings page writes the same configuration) --
# One of: openai | anthropic | ollama
# PEERLENS_AI_PROVIDER=ollama

# OpenAI
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4.1

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Ollama — fully local, no API key, no data leaves your machine.
# From inside Docker, use http://host.docker.internal:11434
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# --- Tuning ----------------------------------------------------------------
# Seconds to wait for a model response. Local reasoning models on CPU are slow;
# a scientific review can legitimately take several minutes.
# PEERLENS_LLM_TIMEOUT=900

# Maximum upload size in bytes (default 25 MB).
# PEERLENS_MAX_UPLOAD_BYTES=26214400

# Sent to OpenAlex to identify your requests (their polite pool). Optional.
# PEERLENS_OPENALEX_MAILTO=you@example.org

# Host and port for the bundled `peerlens` command.
# PEERLENS_HOST=0.0.0.0
# PEERLENS_PORT=8000
